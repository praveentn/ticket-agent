# Copy to .env. Without GROQ_API_KEY the agents run on the deterministic offline path.
GROQ_API_KEY=
GROQ_MODEL_PRIMARY="openai/gpt-oss-120b"
GROQ_MODEL_FALLBACKS="groq/openai/gpt-oss-20b,groq/llama-3.1-8b-instant"
GROQ_MODEL_FALLBACK="llama-3.1-8b-instant"

# Optional overrides
# AUTH_MODE=dev                      # dev | oidc
# JWT_SECRET=change-me
# OIDC_ISSUER= OIDC_AUDIENCE= OIDC_JWKS_URL=
# CONFIDENCE_THRESHOLD=0.55
# ALLOW_SELF_APPROVAL=true           # demo convenience; set false to require a real approver
# TICKETING_FAILURE_RATE=0.3         # inject failures into the mock ticketing system
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
